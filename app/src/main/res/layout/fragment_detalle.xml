<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Nombre del plato y corazón (visible solo si es favorito) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/txtNombrePlato"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgFavorito"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/desc_favorito"
            android:src="@drawable/ic_favorite"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Opciones: Perfil | Fotos | Video | Web | Botones (repartidas en partes iguales) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:checkedButton="@id/btnPerfil"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnPerfil"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="0dp"
            android:paddingVertical="6dp"
            android:text="@string/opcion_perfil"
            android:textSize="10sp"
            app:icon="@drawable/ic_perfil"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="22dp" />

        <Button
            android:id="@+id/btnFotos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="0dp"
            android:paddingVertical="6dp"
            android:text="@string/opcion_fotos"
            android:textSize="10sp"
            app:icon="@drawable/ic_foto"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="22dp" />

        <Button
            android:id="@+id/btnVideo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="0dp"
            android:paddingVertical="6dp"
            android:text="@string/opcion_video"
            android:textSize="10sp"
            app:icon="@drawable/ic_video"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="22dp" />

        <Button
            android:id="@+id/btnWeb"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="0dp"
            android:paddingVertical="6dp"
            android:text="@string/opcion_web"
            android:textSize="10sp"
            app:icon="@drawable/ic_web"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="22dp" />

        <Button
            android:id="@+id/btnBotones"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="0dp"
            android:paddingVertical="6dp"
            android:text="@string/opcion_botones"
            android:textSize="10sp"
            app:icon="@drawable/ic_botones"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="22dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Secciones: solo una se ve a la vez, según la opción elegida -->
    <FrameLayout
        android:id="@+id/contenedorSecciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/secPerfil"
            layout="@layout/seccion_perfil"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/secFotos"
            layout="@layout/seccion_fotos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/secVideo"
            layout="@layout/seccion_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/secWeb"
            layout="@layout/seccion_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/secBotones"
            layout="@layout/seccion_botones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
