<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_colombia"
    android:orientation="vertical"
    tools:context=".RutasGastronomicasActivity">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/btnVolver"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volver"
            android:textColor="@color/amarillo_colombia"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Los dos fragmentos, siempre visibles al mismo tiempo (peso 2 : 3) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:orientation="horizontal">

        <!-- Fragmento izquierdo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEncabezadoListado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/amarillo_colombia"
                android:padding="8dp"
                android:text="@string/encabezado_listado"
                android:textColor="@color/azul_colombia"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragmentoListado"
                android:name="com.example.saboresdecolombia.FragmentoListado"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Divisor entre fragmentos -->
        <View
            android:id="@+id/divisor"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/azul_colombia" />

        <!-- Fragmento derecho -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEncabezadoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/amarillo_colombia"
                android:padding="8dp"
                android:text="@string/encabezado_detalle"
                android:textColor="@color/azul_colombia"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragmentoDetalle"
                android:name="com.example.saboresdecolombia.FragmentoDetalle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
