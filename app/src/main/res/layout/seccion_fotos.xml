<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgFotoGrande"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="@string/desc_foto_plato"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/txtDescripcionFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <!-- Barra de desplazamiento horizontal con las miniaturas -->
        <HorizontalScrollView
            android:id="@+id/scrollMiniaturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/contenedorMiniaturas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
